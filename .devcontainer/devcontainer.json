{
  "name": "Measure Twice",
  "image": "mcr.microsoft.com/devcontainers/php:4-8.4-trixie",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest",
      "profile": "minimal",
      "components": "rustfmt,clippy,rust-analyzer,rust-src"
    }
  },
  "containerEnv": {
    "XDEBUG_MODE": "off"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "waitFor": "postCreateCommand",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "settings": {
        "workbench.editorAssociations": {
          "**/lessons/*/README.md": "vscode.markdown.preview.editor"
        },
        "files.exclude": {
          "**/node_modules": true,
          "**/target": true,
          "**/__pycache__": true,
          ".ruff_cache": true,
          ".devcontainer": true,
          ".github": true,
          ".gitattributes": true,
          ".guide-progress.json": true,
          ".guide-state.json": true,
          "extensions": true,
          "CLAUDE.md": true,
          "Cargo.toml": true,
          "Cargo.lock": true,
          "package.json": true,
          "package-lock.json": true,
          "pyproject.toml": true,
          "tsconfig.json": true
        }
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "ms-python.python",
        "bmewburn.vscode-intelephense-client",
        "-vadimcn.vscode-lldb"
      ]
    }
  }
}
