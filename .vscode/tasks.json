{
  // Starts the guide in its own terminal when the course opens, so a learner
  // lands on step 1 without typing anything. In a Codespace the dev container
  // allows automatic tasks; elsewhere VS Code asks first.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Measure Twice guide",
      "type": "shell",
      "command": "./scripts/guide",
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
